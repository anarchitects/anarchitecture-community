{
  "name": "editorjs-angular-host",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "aa",
  "sourceRoot": "apps/editorjs/angular-host/src",
  "tags": ["scope:editorjs", "type:fixture", "npm:private"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/editorjs/angular-host",
        "browser": "apps/editorjs/angular-host/src/main.ts",
        "tsConfig": "apps/editorjs/angular-host/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/editorjs/angular-host/public"
          }
        ],
        "styles": ["apps/editorjs/angular-host/src/styles.css"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tsconfig.base.json"
      ]
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4317,
        "host": "127.0.0.1"
      },
      "configurations": {
        "production": {
          "buildTarget": "editorjs-angular-host:build:production"
        },
        "development": {
          "buildTarget": "editorjs-angular-host:build:development"
        }
      },
      "dependsOn": ["^build"]
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "editorjs-angular-host:build",
        "port": 4317,
        "staticFilePath": "dist/apps/editorjs/angular-host/browser",
        "spa": false,
        "host": "127.0.0.1",
        "watch": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "options": {
        "command": "ngc -p apps/editorjs/angular-host/tsconfig.app.json --noEmit"
      }
    },
    "build-ssr": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/editorjs/angular-host-ssr",
        "browser": "apps/editorjs/angular-host/src/ssr/main.ts",
        "tsConfig": "apps/editorjs/angular-host/tsconfig.ssr.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/editorjs/angular-host/public"
          }
        ],
        "styles": ["apps/editorjs/angular-host/src/styles.css"],
        "server": "apps/editorjs/angular-host/src/main.server.ts",
        "ssr": {
          "entry": "apps/editorjs/angular-host/src/server.ts"
        },
        "outputMode": "server",
        "statsJson": true,
        "security": {
          "allowedHosts": ["localhost", "127.0.0.1"]
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "diagnostic": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "outputPath": "dist/apps/editorjs/angular-host-ssr-diagnostic"
        },
        "full": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "outputPath": "dist/apps/editorjs/angular-host-ssr-full",
          "fileReplacements": [
            {
              "replace": "apps/editorjs/angular-host/src/ssr/hydration.ts",
              "with": "apps/editorjs/angular-host/src/ssr/hydration.full.ts"
            }
          ]
        },
        "eager-control": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "browser": "apps/editorjs/angular-host/src/isolation/main.eager.ts",
          "tsConfig": "apps/editorjs/angular-host/tsconfig.isolation.json",
          "outputPath": "dist/apps/editorjs/angular-host-ssr-eager"
        }
      },
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tsconfig.base.json",
        {
          "runtime": "node --version"
        },
        "{workspaceRoot}/yarn.lock"
      ],
      "cache": true,
      "dependsOn": ["^build"]
    },
    "serve-ssr": {
      "executor": "nx:run-commands",
      "continuous": true,
      "cache": false,
      "dependsOn": ["build-ssr"],
      "options": {
        "command": "node dist/apps/editorjs/angular-host-ssr/server/server.mjs"
      }
    },
    "typecheck-ssr": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "options": {
        "command": "ngc -p apps/editorjs/angular-host/tsconfig.ssr.json --noEmit"
      }
    },
    "build-hydration": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "yarn nx run editorjs-angular-host:build-ssr:production",
          "yarn nx run editorjs-angular-host:build-ssr:diagnostic",
          "yarn nx run editorjs-angular-host:build-ssr:full"
        ],
        "parallel": false
      }
    },
    "build-isolation": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "yarn nx run editorjs-angular-host:build-ssr:production",
          "yarn nx run editorjs-angular-host:build-ssr:eager-control"
        ],
        "parallel": false
      }
    }
  },
  "implicitDependencies": ["editorjs-angular"]
}
