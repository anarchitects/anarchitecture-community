{
  "name": "editorjs-angular-e2e",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/editorjs/angular-e2e/src",
  "implicitDependencies": ["editorjs-angular-host"],
  "targets": {
    "e2e": {
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "^production",
        {
          "env": "CI"
        },
        {
          "runtime": "node -p \"process.platform + process.arch\""
        },
        "{workspaceRoot}/tsconfig.base.json"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/tsconfig.base.json"],
      "options": {
        "command": "tsc -p apps/editorjs/angular-e2e/tsconfig.json --noEmit"
      }
    },
    "install-browsers": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright install chromium"
      },
      "cache": false,
      "configurations": {
        "ci": {
          "command": "playwright install chromium --with-deps --only-shell"
        }
      }
    },
    "e2e-packed": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/test-output/compatibility"],
      "options": {
        "command": "node apps/editorjs/angular-e2e/tools/validate-packed.mjs {args.cell}",
        "cell": "all"
      }
    },
    "e2e-packed-ssr": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "dependsOn": [
        {
          "projects": ["editorjs-angular"],
          "target": "build",
          "params": "ignore"
        }
      ],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/yarn.lock",
        {
          "runtime": "node --version"
        },
        {
          "env": "CI"
        }
      ],
      "outputs": ["{projectRoot}/test-output/ssr-compatibility"],
      "options": {
        "command": "node apps/editorjs/angular-e2e/tools/validate-packed.mjs {args.cell} ssr",
        "cell": "all"
      }
    },
    "test-ssr": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["editorjs-angular-host"],
          "target": "build-ssr"
        }
      ],
      "outputs": ["{projectRoot}/test-output/ssr"],
      "options": {
        "command": "node apps/editorjs/angular-e2e/tools/validate-ssr.mjs"
      },
      "parallelism": false
    },
    "e2e-hydration": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "dependsOn": [
        {
          "projects": ["editorjs-angular-host"],
          "target": "build-hydration"
        }
      ],
      "outputs": ["{projectRoot}/test-output/hydration"],
      "options": {
        "cwd": "apps/editorjs/angular-e2e",
        "command": "playwright test --config=playwright.hydration.config.mts"
      }
    },
    "e2e-isolation": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "dependsOn": [
        {
          "projects": ["editorjs-angular-host"],
          "target": "build-isolation"
        }
      ],
      "outputs": ["{projectRoot}/test-output/isolation"],
      "options": {
        "cwd": "apps/editorjs/angular-e2e",
        "command": "playwright test --config=playwright.isolation.config.mts"
      }
    }
  },
  "tags": ["scope:editorjs", "type:e2e", "npm:private"]
}
