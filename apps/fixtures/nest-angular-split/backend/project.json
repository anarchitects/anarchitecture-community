{
  "name": "nest-angular-split-backend",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/fixtures/nest-angular-split/backend/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "fixture-build": {
      "executor": "nx:run-commands",
      "parallelism": false,
      "dependsOn": ["nest-angular-split-frontend:fixture-build", "^build"],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/yarn.lock",
        {
          "runtime": "node -p \"JSON.stringify([process.version, process.platform, process.arch])\""
        },
        {
          "env": "NODE_OPTIONS"
        },
        "{workspaceRoot}/tsconfig.json"
      ],
      "options": {
        "command": "webpack-cli build",
        "env": {
          "NODE_ENV": "production"
        },
        "cwd": "apps/fixtures/nest-angular-split/backend"
      },
      "configurations": {
        "development": {
          "env": {
            "NODE_ENV": "development"
          }
        }
      },
      "cache": true,
      "outputs": ["{projectRoot}/dist"]
    },
    "prune-lockfile": {
      "dependsOn": ["fixture-build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/apps/fixtures/nest-angular-split/backend/dist/package.json",
        "{workspaceRoot}/apps/fixtures/nest-angular-split/backend/dist/yarn.lock"
      ],
      "options": {
        "buildTarget": "fixture-build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["fixture-build"],
      "cache": true,
      "outputs": [
        "{workspaceRoot}/apps/fixtures/nest-angular-split/backend/dist/workspace_modules"
      ],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "fixture-build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["fixture-build"],
      "options": {
        "buildTarget": "nest-angular-split-backend:fixture-build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "nest-angular-split-backend:fixture-build:development"
        },
        "production": {
          "buildTarget": "nest-angular-split-backend:fixture-build:production"
        }
      }
    },
    "test": {
      "dependsOn": ["nest-angular-ssr:build"],
      "options": {
        "passWithNoTests": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/fixtures/nest-angular-split/backend/tsconfig.app.json"
      },
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/yarn.lock",
        {
          "runtime": "node -p \"JSON.stringify([process.version, process.platform, process.arch])\""
        },
        {
          "env": "NODE_OPTIONS"
        },
        "{workspaceRoot}/apps/fixtures/nest-angular-split/tsconfig.base.json"
      ],
      "outputs": ["{projectRoot}/dist/tsconfig.app.tsbuildinfo"],
      "dependsOn": ["^build"]
    }
  }
}
