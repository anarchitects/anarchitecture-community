{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "nest-cjs-consumer",
  "projectType": "application",
  "root": "apps/fixtures/nest-cjs-consumer",
  "sourceRoot": "apps/fixtures/nest-cjs-consumer/src",
  "implicitDependencies": ["nest-angular-ssr"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "npm run build",
        "cwd": "apps/fixtures/nest-cjs-consumer"
      },
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/yarn.lock",
        {
          "runtime": "node -p \"JSON.stringify([process.version, process.platform, process.arch])\""
        },
        {
          "env": "NODE_OPTIONS"
        }
      ],
      "outputs": ["{projectRoot}/dist"]
    },
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "npm run start",
        "cwd": "apps/fixtures/nest-cjs-consumer"
      }
    },
    "validate-consumption": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/fixtures/validate-nest-angular-ssr-consumers.mjs nest-cjs-consumer"
      }
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "cache": true,
      "inputs": [
        "{projectRoot}/package.json",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/tsconfig.app.json",
        "{projectRoot}/src/**/*.ts",
        {
          "dependentTasksOutputFiles": "**/*.{d.ts,tsbuildinfo}",
          "transitive": true
        },
        "^{projectRoot}/tsconfig.lib.json"
      ],
      "outputs": [
        "{projectRoot}/dist/**/*.d.ts",
        "{projectRoot}/dist/tsconfig.app.tsbuildinfo"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/fixtures/nest-cjs-consumer",
        "command": "tsc --project tsconfig.app.json --noEmit"
      }
    }
  },
  "tags": []
}
