    "vitest": "~4.0.0",
    "zone.js": "^0.16.1"
  },
  "workspaces": [
    "packages/*/*"
  ],
  "packageManager": "yarn@4.13.0",
  "nx": {
    "includedScripts": [],
    "targets": {
      "validate-nest-angular-ssr-consumers": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node tools/fixtures/validate-nest-angular-ssr-consumers.mjs all"
        }
      },
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      }
    }
  }
