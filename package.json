{
  "name": "@anarchitecture-community/source",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "validate:governance-packages": "yarn nx run @anarchitecture-community/source:validate-governance-release-gate"
  },
  "devDependencies": {
    "@angular-devkit/core": "~22.2.0",
    "@angular-devkit/schematics": "~22.2.0",
    "@angular/build": "~22.2.0",
    "@angular/common": "~22.2.0",
    "@angular/compiler": "~22.2.0",
    "@angular/compiler-cli": "~22.2.0",
    "@angular/core": "~22.2.0",
    "@angular/forms": "~22.2.0",
    "@angular/platform-browser": "~22.2.0",
    "@angular/platform-server": "~22.2.0",
    "@angular/router": "~22.2.0",
    "@angular/ssr": "~22.2.0",
    "@eslint/js": "^9.8.0",
    "@fastify/static": "10.1.11",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-fastify": "12.5.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "12.5.0",
    "@nx/angular": "24.0.6",
    "@nx/devkit": "24.0.6",
    "@nx/eslint": "24.0.6",
    "@nx/eslint-plugin": "24.0.6",
    "@nx/jest": "24.0.6",
    "@nx/js": "24.0.6",
    "@nx/nest": "24.0.6",
    "@nx/node": "24.0.6",
    "@nx/playwright": "24.0.6",
    "@nx/vite": "24.0.6",
    "@nx/vitest": "24.0.6",
    "@nx/web": "24.0.6",
    "@nx/webpack": "24.0.6",
    "@nxlv/python": "^22.2.0",
    "@playwright/test": "1.64.0",
    "@schematics/angular": "~22.2.0",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "20.19.9",
    "@typescript-eslint/parser": "8.68.0",
    "@typescript-eslint/utils": "8.68.0",
    "@vitest/coverage-v8": "~4.0.0",
    "@vitest/ui": "~4.0.0",
    "ajv": "^8.0.0",
    "angular-eslint": "22.7.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "fastify": "5.12.8",
    "jest": "~30.3.0",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "ng-packagr": "~22.2.0",
    "nx": "24.0.6",
    "postcss": "^8.4.5",
    "prettier": "~3.6.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.4.12",
    "tslib": "^2.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "verdaccio": "6.7.2",
    "vite": "8.0.9",
    "vite-plugin-dts": "~4.5.0",
    "vitest": "~4.0.0",
    "webpack": "5.107.2",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "5.2.5",
    "zone.js": "~0.16.2"
  },
  "workspaces": [
    "packages/*/*",
    "apps/fixtures/nest-angular-split/*",
    "apps/editorjs/*",
    "apps/fixtures/nest-cjs-consumer",
    "apps/fixtures/nest-esm-consumer"
  ],
  "packageManager": "yarn@4.18.1",
  "nx": {
    "includedScripts": [],
    "targets": {
      "test-release-policy": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{workspaceRoot}/tools/release/**/*",
          "{workspaceRoot}/tools/fixtures/**/*",
          "{workspaceRoot}/.github/workflows/ci.yml",
          "{workspaceRoot}/nx.json",
          "{workspaceRoot}/package.json",
          "{workspaceRoot}/yarn.lock",
          {
            "runtime": "node -p \"JSON.stringify([process.version, process.platform, process.arch])\""
          },
          {
            "runtime": "python3 --version"
          },
          {
            "runtime": "git --version"
          },
          {
            "runtime": "npm --version"
          },
          "{workspaceRoot}/.github/workflows/release*.yml",
          "{workspaceRoot}/.github/workflows/publish*.yml"
        ],
        "outputs": [],
        "options": {
          "command": "node --test tools/release/*.test.mjs"
        }
      },
      "validate-release-policy": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node tools/release/check.mjs config"
        }
      },
      "validate-commit-policy": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node tools/release/check.mjs ci"
        }
      },
      "release-history": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node tools/release/check.mjs history"
        }
      },
      "preview-release-policy": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node tools/release/check.mjs preview"
        }
      },
      "test-nest-angular-ssr-consumer-lifecycle": {
        "executor": "nx:noop",
        "cache": false,
        "dependsOn": [
          {
            "projects": [
              "nest-angular-ssr"
            ],
            "target": "test-consumer-lifecycle",
            "params": "forward"
          }
        ]
      },
      "validate-nest-angular-ssr-consumers": {
        "executor": "nx:noop",
        "cache": false,
        "dependsOn": [
          {
            "projects": [
              "nest-angular-ssr"
            ],
            "target": "validate-consumers",
            "params": "forward"
          }
        ]
      },
      "validate-nest-angular-ssr-matrix": {
        "executor": "nx:noop",
        "cache": false,
        "dependsOn": [
          {
            "projects": [
              "nest-angular-ssr"
            ],
            "target": "validate-matrix",
            "params": "forward"
          }
        ]
      },
      "validate-nest-angular-ssr-split": {
        "executor": "nx:noop",
        "cache": false,
        "dependsOn": [
          {
            "projects": [
              "nest-angular-ssr"
            ],
            "target": "validate-split",
            "params": "forward"
          }
        ]
      },
      "validate-nest-angular-ssr-release-gate": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "yarn nx run-many -t build,typecheck,test,lint -p nest-angular-ssr",
            "yarn nx run nest-angular-ssr:install-consumer-browser",
            "yarn nx run nest-angular-ssr:validate-locked-consumers --cell=nest12"
          ],
          "parallel": false
        },
        "cache": false
      },
      "validate-governance-release-gate": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "yarn nx run-many -t build,typecheck,test,lint -p governance-core governance-adapter-dbt governance-adapter-typescript governance-extension-dbt governance-extension-typescript governance-runtime-dbt governance-cli",
            "UV_CACHE_DIR=.cache/uv yarn nx run governance-host-dbt:build",
            "UV_CACHE_DIR=.cache/uv yarn nx run governance-host-dbt:lint",
            "UV_CACHE_DIR=.cache/uv yarn nx run governance-host-dbt:test",
            "UV_CACHE_DIR=.cache/uv yarn nx run governance-host-dbt:e2e",
            "node tools/governance/validate-community-governance.mjs all"
          ],
          "parallel": false
        }
      },
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      },
      "test-ci-selection": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node --test tools/ci/*.test.mjs"
        }
      },
      "prepare-release-version": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node tools/release/prepare.mjs version"
        }
      },
      "freeze-release-record": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node tools/release/prepare.mjs freeze"
        }
      }
    },
    "implicitDependencies": [
      "nest-angular-ssr",
      "nest-cjs-consumer",
      "nest-esm-consumer",
      "nest-angular-split-backend",
      "nest-angular-split-frontend"
    ]
  }
}
