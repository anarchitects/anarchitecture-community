{
  "name": "@anarchitects/governance-runtime-dbt",
  "version": "0.1.0",
  "description": "dbt Governance runtime composition boundary for future composition of Core, adapter, and extension layers.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anarchitects/anarchitecture-community.git",
    "directory": "packages/governance/runtime-dbt"
  },
  "bugs": {
    "url": "https://github.com/anarchitects/anarchitecture-community/issues"
  },
  "homepage": "https://github.com/anarchitects/anarchitecture-community/tree/main/packages/governance/runtime-dbt#readme",
  "keywords": [
    "governance",
    "dbt",
    "runtime"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@anarchitecture-community/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "governance-runtime-dbt",
    "tags": [
      "npm:public",
      "npm:governance",
      "npm:dbt",
      "npm:runtime",
      "scope:governance",
      "type:runtime",
      "platform:node",
      "integration:dbt"
    ],
    "targets": {
      "test": {
        "executor": "@nx/vitest:test",
        "outputs": [
          "{options.reportsDirectory}"
        ],
        "options": {
          "reportsDirectory": "coverage/packages/governance/runtime-dbt"
        }
      }
    }
  },
  "dependencies": {
    "@anarchitects/governance-adapter-dbt": "^0.1.4",
    "@anarchitects/governance-core": "^0.4.1",
    "@anarchitects/governance-extension-dbt": "^0.1.4"
  }
}
