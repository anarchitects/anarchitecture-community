{
  "name": "@anarchitects/governance-core",
  "version": "0.1.1",
  "description": "Platform-independent Governance Core contracts, deterministic logic, and portable extension APIs for the Community repository.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anarchitects/anarchitecture-community.git",
    "directory": "packages/governance/core"
  },
  "bugs": {
    "url": "https://github.com/anarchitects/anarchitecture-community/issues"
  },
  "homepage": "https://github.com/anarchitects/anarchitecture-community/tree/main/packages/governance/core#readme",
  "keywords": [
    "governance"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@anarchitecture-community/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "governance-core",
    "targets": {
      "test": {
        "executor": "@nx/vitest:test",
        "outputs": [
          "{options.reportsDirectory}"
        ],
        "options": {
          "reportsDirectory": "coverage/packages/governance/core"
        }
      }
    }
  }
}
