{
  "name": "@anarchitects/governance-adapter-typescript",
  "version": "0.2.2",
  "description": "Platform-independent Governance TypeScript workspace adapter that normalizes discovery into Governance Core contracts.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anarchitects/anarchitecture-community.git",
    "directory": "packages/governance/adapter-typescript"
  },
  "bugs": {
    "url": "https://github.com/anarchitects/anarchitecture-community/issues"
  },
  "homepage": "https://github.com/anarchitects/anarchitecture-community/tree/main/packages/governance/adapter-typescript#readme",
  "keywords": [
    "governance",
    "typescript",
    "adapter"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@anarchitecture-community/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "governance-adapter-typescript",
    "targets": {
      "test": {
        "executor": "@nx/vitest:test",
        "outputs": [
          "{options.reportsDirectory}"
        ],
        "options": {
          "reportsDirectory": "coverage/packages/governance/adapter-typescript"
        }
      }
    }
  },
  "dependencies": {
    "@anarchitects/governance-core": "^0.1.2",
    "minimatch": "^10.1.1",
    "typescript": "~5.9.2",
    "yaml": "^2.8.1"
  }
}
