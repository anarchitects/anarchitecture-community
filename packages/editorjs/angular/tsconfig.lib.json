{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/lib",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "sourceMap": true,
    "types": []
  },
  "include": ["src/**/*.ts", "forms/src/**/*.ts"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "forms/src/**/*.spec.ts",
    "forms/src/**/*.test.ts"
  ],
  "nx": {
    "sync": {
      "ignoredDependencies": ["editorjs-core"]
    }
  }
}
