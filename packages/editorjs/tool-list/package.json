{
  "name": "@anarchitects/editorjs-tool-list",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@anarchitecture-community/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "@anarchitecture-community/source": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "name": "editorjs-tool-list",
    "targets": {
      "test": {
        "executor": "@nx/vitest:test",
        "outputs": [
          "{options.reportsDirectory}"
        ],
        "options": {
          "reportsDirectory": "coverage/packages/editorjs/tool-list"
        },
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "listTests",
          "^default"
        ]
      },
      "vite:test": {
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "listTests",
          "^default"
        ]
      },
      "vitest:test": {
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "listTests",
          "^default"
        ]
      },
      "test-ci--tests/package.spec.ts": {
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "listTests",
          "^default"
        ]
      },
      "build": {
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/tsconfig.base.json",
          "{workspaceRoot}/yarn.lock",
          {
            "runtime": "node -p \"JSON.stringify([process.version, process.platform, process.arch])\""
          },
          {
            "env": "NODE_OPTIONS"
          },
          "{workspaceRoot}/tsconfig.json"
        ]
      },
      "typecheck": {
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/tsconfig.base.json",
          "{workspaceRoot}/yarn.lock",
          {
            "runtime": "node -p \"JSON.stringify([process.version, process.platform, process.arch])\""
          },
          {
            "env": "NODE_OPTIONS"
          },
          "{workspaceRoot}/tsconfig.json"
        ],
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/out-tsc/typecheck"
        ],
        "options": {
          "cwd": "packages/editorjs/tool-list",
          "commands": [
            "tsc --project tsconfig.lib.json --noEmit --tsBuildInfoFile out-tsc/typecheck/lib.tsbuildinfo",
            "tsc --project tsconfig.spec.json --noEmit --tsBuildInfoFile out-tsc/typecheck/spec.tsbuildinfo"
          ],
          "parallel": false
        },
        "dependsOn": [
          "build",
          "^typecheck"
        ],
        "cache": true
      },
      "lint": {
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/tsconfig.base.json",
          "{workspaceRoot}/yarn.lock",
          {
            "runtime": "node -p \"JSON.stringify([process.version, process.platform, process.arch])\""
          },
          {
            "env": "NODE_OPTIONS"
          },
          "{workspaceRoot}/tsconfig.json",
          "{workspaceRoot}/eslint.config.mjs",
          "{workspaceRoot}/tools/eslint-rules/**/*"
        ]
      },
      "test-ci--tests/browser.spec.ts": {
        "inputs": [
          "listTests",
          "^default"
        ],
        "dependsOn": [
          "build"
        ]
      },
      "test-ci--tests/list.spec.ts": {
        "inputs": [
          "listTests",
          "^default"
        ],
        "dependsOn": [
          "build"
        ]
      },
      "test-ci": {
        "inputs": [
          "listTests",
          "^default"
        ]
      }
    },
    "namedInputs": {
      "listTests": [
        "default",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/yarn.lock",
        {
          "runtime": "node -p \"JSON.stringify([process.version, process.platform, process.arch])\""
        },
        {
          "env": "NODE_OPTIONS"
        },
        "{workspaceRoot}/tsconfig.json",
        {
          "env": "CI"
        }
      ]
    }
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anarchitects/anarchitecture-community.git",
    "directory": "packages/editorjs/tool-list"
  },
  "bugs": {
    "url": "https://github.com/anarchitects/anarchitecture-community/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Typed nested list definitions and saved-data validation with an explicit Editor.js browser entry.",
  "homepage": "https://github.com/anarchitects/anarchitecture-community/tree/main/packages/editorjs/tool-list#readme",
  "sideEffects": [
    "./dist/browser.js",
    "./src/browser.ts"
  ],
  "dependencies": {
    "@anarchitects/editorjs-core": "^0.0.1",
    "@editorjs/list": "2.0.9"
  },
  "peerDependencies": {
    "@editorjs/editorjs": "2.31.7"
  }
}
