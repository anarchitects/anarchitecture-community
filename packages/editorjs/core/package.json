{
  "name": "@anarchitects/editorjs-core",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@anarchitecture-community/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "name": "editorjs-core",
    "targets": {
      "test": {
        "executor": "@nx/vitest:test",
        "outputs": [
          "{options.reportsDirectory}"
        ],
        "options": {
          "reportsDirectory": "coverage/packages/editorjs/core"
        },
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/tsconfig.base.json",
          "{workspaceRoot}/yarn.lock",
          {
            "runtime": "node -p \"JSON.stringify([process.version, process.platform, process.arch])\""
          },
          {
            "env": "NODE_OPTIONS"
          },
          "{workspaceRoot}/tsconfig.json",
          {
            "env": "CI"
          }
        ]
      },
      "vite:test": {
        "dependsOn": [
          "build"
        ]
      },
      "vitest:test": {
        "dependsOn": [
          "build"
        ]
      },
      "test-ci--tests/package.spec.ts": {
        "dependsOn": [
          "build"
        ]
      },
      "build": {
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/tsconfig.base.json",
          "{workspaceRoot}/yarn.lock",
          {
            "runtime": "node -p \"JSON.stringify([process.version, process.platform, process.arch])\""
          },
          {
            "env": "NODE_OPTIONS"
          },
          "{workspaceRoot}/tsconfig.json"
        ]
      },
      "typecheck": {
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/tsconfig.base.json",
          "{workspaceRoot}/yarn.lock",
          {
            "runtime": "node -p \"JSON.stringify([process.version, process.platform, process.arch])\""
          },
          {
            "env": "NODE_OPTIONS"
          },
          "{workspaceRoot}/tsconfig.json"
        ],
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/out-tsc/typecheck"
        ],
        "options": {
          "cwd": "packages/editorjs/core",
          "commands": [
            "tsc --project tsconfig.lib.json --noEmit --tsBuildInfoFile out-tsc/typecheck/lib.tsbuildinfo",
            "tsc --project tsconfig.spec.json --noEmit --tsBuildInfoFile out-tsc/typecheck/spec.tsbuildinfo"
          ],
          "parallel": false
        },
        "dependsOn": [
          "build",
          "^typecheck"
        ],
        "cache": true
      },
      "lint": {
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/tsconfig.base.json",
          "{workspaceRoot}/yarn.lock",
          {
            "runtime": "node -p \"JSON.stringify([process.version, process.platform, process.arch])\""
          },
          {
            "env": "NODE_OPTIONS"
          },
          "{workspaceRoot}/tsconfig.json",
          "{workspaceRoot}/eslint.config.mjs",
          "{workspaceRoot}/tools/eslint-rules/**/*"
        ]
      },
      "test-ci--tests/upload-operation.spec.ts": {
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/tsconfig.base.json",
          "{workspaceRoot}/yarn.lock",
          {
            "runtime": "node -p \"JSON.stringify([process.version, process.platform, process.arch])\""
          },
          {
            "env": "NODE_OPTIONS"
          },
          "{workspaceRoot}/tsconfig.json",
          {
            "env": "CI"
          }
        ]
      }
    }
  },
  "description": "Framework-neutral contracts and utilities for Editor.js integrations.",
  "license": "Apache-2.0",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anarchitects/anarchitecture-community.git",
    "directory": "packages/editorjs/core"
  },
  "bugs": {
    "url": "https://github.com/anarchitects/anarchitecture-community/issues"
  },
  "homepage": "https://github.com/anarchitects/anarchitecture-community/tree/main/packages/editorjs/core#readme",
  "keywords": [
    "editorjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@editorjs/editorjs": "2.31.7"
  }
}
