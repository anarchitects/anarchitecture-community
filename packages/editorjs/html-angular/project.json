{
  "name": "editorjs-html-angular",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/editorjs/html-angular/src",
  "prefix": "aa",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": ["npm:public", "scope:editorjs", "type:angular"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "packages/editorjs/html-angular/ng-package.json",
        "tsConfig": "packages/editorjs/html-angular/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/editorjs/html-angular/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/tsconfig.json",
        "{workspaceRoot}/yarn.lock",
        {
          "runtime": "node -p \"JSON.stringify([process.version, process.platform, process.arch])\""
        },
        {
          "env": "NODE_OPTIONS"
        }
      ]
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/tsconfig.json",
        "{workspaceRoot}/yarn.lock",
        {
          "runtime": "node -p \"JSON.stringify([process.version, process.platform, process.arch])\""
        },
        {
          "env": "NODE_OPTIONS"
        },
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["build"],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/tsconfig.json",
        "{workspaceRoot}/yarn.lock",
        {
          "runtime": "node -p \"JSON.stringify([process.version, process.platform, process.arch])\""
        },
        {
          "env": "NODE_OPTIONS"
        }
      ],
      "options": {
        "cwd": "packages/editorjs/html-angular",
        "commands": [
          "ngc -p tsconfig.lib.json --noEmit",
          "tsc -p tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["build"],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/tsconfig.json",
        "{workspaceRoot}/yarn.lock",
        {
          "runtime": "node -p \"JSON.stringify([process.version, process.platform, process.arch])\""
        },
        {
          "env": "NODE_OPTIONS"
        },
        {
          "env": "CI"
        }
      ],
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "cwd": "packages/editorjs/html-angular",
        "command": "vitest run"
      }
    },
    "test-ci--tests/component.spec.ts": {
      "dependsOn": ["build"],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/tsconfig.json",
        "{workspaceRoot}/yarn.lock",
        {
          "runtime": "node -p \"JSON.stringify([process.version, process.platform, process.arch])\""
        },
        {
          "env": "NODE_OPTIONS"
        },
        {
          "env": "CI"
        }
      ],
      "options": {
        "env": {}
      }
    },
    "test-ci--tests/package.spec.ts": {
      "dependsOn": ["build"],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/tsconfig.json",
        "{workspaceRoot}/yarn.lock",
        {
          "runtime": "node -p \"JSON.stringify([process.version, process.platform, process.arch])\""
        },
        {
          "env": "NODE_OPTIONS"
        },
        {
          "env": "CI"
        }
      ],
      "options": {
        "env": {}
      }
    },
    "packed-smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node packages/editorjs/html-angular/tools/packed-smoke.mjs"
      },
      "outputs": ["{workspaceRoot}/dist/test-results/editorjs-html-angular"]
    },
    "vite:test": {
      "dependsOn": ["build"],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/tsconfig.json",
        "{workspaceRoot}/yarn.lock",
        {
          "runtime": "node -p \"JSON.stringify([process.version, process.platform, process.arch])\""
        },
        {
          "env": "NODE_OPTIONS"
        },
        {
          "env": "CI"
        }
      ]
    },
    "vitest:test": {
      "dependsOn": ["build"],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/tsconfig.json",
        "{workspaceRoot}/yarn.lock",
        {
          "runtime": "node -p \"JSON.stringify([process.version, process.platform, process.arch])\""
        },
        {
          "env": "NODE_OPTIONS"
        },
        {
          "env": "CI"
        }
      ]
    },
    "test-ci--tests/directive.spec.ts": {
      "dependsOn": ["build"],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/tsconfig.json",
        "{workspaceRoot}/yarn.lock",
        {
          "runtime": "node -p \"JSON.stringify([process.version, process.platform, process.arch])\""
        },
        {
          "env": "NODE_OPTIONS"
        },
        {
          "env": "CI"
        }
      ],
      "options": {
        "env": {}
      }
    },
    "test-ci--tests/providers.spec.ts": {
      "dependsOn": ["build"],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/tsconfig.json",
        "{workspaceRoot}/yarn.lock",
        {
          "runtime": "node -p \"JSON.stringify([process.version, process.platform, process.arch])\""
        },
        {
          "env": "NODE_OPTIONS"
        },
        {
          "env": "CI"
        }
      ],
      "options": {
        "env": {}
      }
    },
    "packed-collect": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node packages/editorjs/html-angular/tools/packed/run.mjs collect"
      }
    },
    "packed-harness-test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        {
          "runtime": "node --version"
        }
      ],
      "options": {
        "command": "node --test packages/editorjs/html-angular/tools/packed/artifacts.test.mjs"
      }
    }
  }
}
