{
  "name": "@anarchitects/better-auth-typeorm-adapter",
  "version": "0.0.1",
  "description": "Framework-neutral Better Auth database adapter infrastructure for TypeORM.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anarchitects/anarchitecture-community.git",
    "directory": "packages/better-auth/typeorm-adapter"
  },
  "bugs": {
    "url": "https://github.com/anarchitects/anarchitecture-community/issues"
  },
  "homepage": "https://github.com/anarchitects/anarchitecture-community/tree/main/packages/better-auth/typeorm-adapter#readme",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@anarchitecture-community/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "better-auth-typeorm-adapter",
    "targets": {
      "test": {
        "executor": "@nx/vitest:test",
        "outputs": [
          "{options.reportsDirectory}"
        ],
        "options": {
          "reportsDirectory": "coverage/packages/better-auth/typeorm-adapter"
        }
      },
      "test-postgres": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/better-auth/typeorm-adapter",
          "command": "vitest run --config vitest.postgres.config.mts"
        }
      },
      "test-better-auth": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/better-auth/typeorm-adapter",
          "command": "vitest run --config vitest.better-auth.config.mts"
        }
      }
    }
  },
  "peerDependencies": {
    "better-auth": "^1.0.0",
    "typeorm": "^0.3.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@types/pg": "^8.11.0",
    "better-auth": "^1.0.0",
    "pg": "^8.0.0",
    "testcontainers": "^10.0.0",
    "typeorm": "^0.3.0"
  }
}
