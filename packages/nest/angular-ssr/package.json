{
  "name": "@anarchitects/nest-angular-ssr",
  "version": "0.2.1",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anarchitects/anarchitecture-community.git",
    "directory": "packages/nest/angular-ssr"
  },
  "bugs": {
    "url": "https://github.com/anarchitects/anarchitecture-community/issues"
  },
  "homepage": "https://github.com/anarchitects/anarchitecture-community/tree/main/packages/nest/angular-ssr#readme",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@anarchitecture-community/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@angular/core": "^21.0.0 || ^22.0.0",
    "@angular/platform-browser": "^21.0.0 || ^22.0.0",
    "@angular/router": "^21.0.0 || ^22.0.0",
    "@angular/ssr": "^21.0.0 || ^22.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "fastify": "^5.0.0",
    "reflect-metadata": "^0.2.0"
  },
  "nx": {
    "name": "nest-angular-ssr",
    "targets": {
      "typecheck": {
        "parallelism": false
      },
      "test": {
        "executor": "@nx/vitest:test",
        "outputs": [
          "{options.reportsDirectory}"
        ],
        "options": {
          "reportsDirectory": "coverage/packages/nest/angular-ssr"
        }
      }
    }
  },
  "dependencies": {
    "@fastify/static": "^8.2.0"
  }
}
