{
  "name": "@anarchitects/nest-angular-ssr",
  "version": "0.5.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anarchitects/anarchitecture-community.git",
    "directory": "packages/nest/angular-ssr"
  },
  "bugs": {
    "url": "https://github.com/anarchitects/anarchitecture-community/issues"
  },
  "homepage": "https://github.com/anarchitects/anarchitecture-community/tree/main/packages/nest/angular-ssr#readme",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@anarchitecture-community/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@angular/core": "~22.2.6",
    "@angular/platform-browser": "~22.2.6",
    "@angular/router": "~22.2.6",
    "@angular/ssr": "~22.2.7",
    "@nestjs/common": "~12.5.0",
    "@nestjs/core": "~12.5.0",
    "@nestjs/platform-fastify": "~12.5.0",
    "fastify": "~5.12.8",
    "reflect-metadata": "^0.2.0"
  },
  "nx": {
    "name": "nest-angular-ssr",
    "targets": {
      "typecheck": {
        "parallelism": false
      },
      "test": {
        "executor": "@nx/vitest:test",
        "outputs": [
          "{options.reportsDirectory}"
        ],
        "options": {
          "reportsDirectory": "coverage/packages/nest/angular-ssr"
        }
      },
      "test-consumer-lifecycle": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node --test tools/fixtures/nest-angular-ssr-consumer-attempt.test.mjs"
        },
        "inputs": [
          "default",
          "{workspaceRoot}/tools/fixtures/*nest-angular-ssr*",
          "{workspaceRoot}/apps/fixtures/nest-cjs-consumer/**/*",
          "{workspaceRoot}/apps/fixtures/nest-esm-consumer/**/*",
          "{workspaceRoot}/apps/fixtures/nest-angular-split/**/*"
        ]
      },
      "validate-consumers": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "test-consumer-lifecycle"
        ],
        "options": {
          "command": "node tools/fixtures/validate-nest-angular-ssr-consumers.mjs all"
        },
        "cache": false,
        "inputs": [
          "default",
          "{workspaceRoot}/tools/fixtures/*nest-angular-ssr*",
          "{workspaceRoot}/apps/fixtures/nest-cjs-consumer/**/*",
          "{workspaceRoot}/apps/fixtures/nest-esm-consumer/**/*",
          "{workspaceRoot}/apps/fixtures/nest-angular-split/**/*"
        ]
      },
      "validate-matrix": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node tools/fixtures/validate-nest-angular-ssr-matrix.mjs {args.cell}"
        },
        "cache": false,
        "inputs": [
          "default",
          "{workspaceRoot}/tools/fixtures/*nest-angular-ssr*",
          "{workspaceRoot}/apps/fixtures/nest-cjs-consumer/**/*",
          "{workspaceRoot}/apps/fixtures/nest-esm-consumer/**/*",
          "{workspaceRoot}/apps/fixtures/nest-angular-split/**/*"
        ]
      },
      "validate-split": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node tools/fixtures/validate-nest-angular-ssr-split.mjs"
        },
        "cache": false,
        "inputs": [
          "default",
          "{workspaceRoot}/tools/fixtures/*nest-angular-ssr*",
          "{workspaceRoot}/apps/fixtures/nest-cjs-consumer/**/*",
          "{workspaceRoot}/apps/fixtures/nest-esm-consumer/**/*",
          "{workspaceRoot}/apps/fixtures/nest-angular-split/**/*"
        ]
      },
      "validate-locked-consumers": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build",
          "test-consumer-lifecycle",
          "test-locked-consumers"
        ],
        "cache": false,
        "inputs": [
          "default",
          "{workspaceRoot}/tools/fixtures/*nest-angular-ssr*",
          "{workspaceRoot}/tools/fixtures/nest-angular-ssr-locks/**/*",
          "{workspaceRoot}/apps/fixtures/nest-cjs-consumer/**/*",
          "{workspaceRoot}/apps/fixtures/nest-esm-consumer/**/*",
          "{workspaceRoot}/apps/fixtures/nest-angular-split/**/*",
          {
            "runtime": "node -p \"JSON.stringify([process.version, process.platform, process.arch])\""
          },
          "{workspaceRoot}/.github/workflows/ci.yml",
          {
            "env": "PLAYWRIGHT_BROWSERS_PATH"
          }
        ],
        "options": {
          "command": "node tools/fixtures/validate-nest-angular-ssr-locked.mjs"
        },
        "outputs": [
          "{workspaceRoot}/dist/validation/nest12-ssr-740"
        ]
      },
      "refresh-consumer-locks": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node tools/fixtures/refresh-nest-angular-ssr-locks.mjs {args.cell}"
        }
      },
      "test-locked-consumers": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "default",
          "{workspaceRoot}/tools/fixtures/*nest-angular-ssr*",
          "{workspaceRoot}/tools/fixtures/nest-angular-ssr-locks/**/*",
          "{workspaceRoot}/apps/fixtures/nest-cjs-consumer/**/*",
          "{workspaceRoot}/apps/fixtures/nest-esm-consumer/**/*",
          "{workspaceRoot}/apps/fixtures/nest-angular-split/**/*",
          {
            "runtime": "node -p \"JSON.stringify([process.version, process.platform, process.arch])\""
          }
        ],
        "options": {
          "command": "node --test tools/fixtures/nest-angular-ssr-locked-support.test.mjs"
        }
      },
      "install-consumer-browser": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "playwright install --with-deps chromium"
        }
      }
    }
  },
  "dependencies": {
    "@fastify/static": "~10.1.11"
  },
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "devDependencies": {
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/platform-server": "22.2.6",
    "@angular/router": "22.2.6",
    "@angular/ssr": "22.2.7",
    "rxjs": "7.8.2"
  }
}
