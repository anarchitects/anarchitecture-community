{
  "name": "@anarchitects/nest-angular-ssr",
  "version": "0.3.2",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anarchitects/anarchitecture-community.git",
    "directory": "packages/nest/angular-ssr"
  },
  "bugs": {
    "url": "https://github.com/anarchitects/anarchitecture-community/issues"
  },
  "homepage": "https://github.com/anarchitects/anarchitecture-community/tree/main/packages/nest/angular-ssr#readme",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@anarchitecture-community/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@angular/core": "^21.0.0 || ^22.0.0",
    "@angular/platform-browser": "^21.0.0 || ^22.0.0",
    "@angular/router": "^21.0.0 || ^22.0.0",
    "@angular/ssr": "^21.0.0 || ^22.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.1.29",
    "fastify": "^5.0.0",
    "reflect-metadata": "^0.2.0"
  },
  "nx": {
    "name": "nest-angular-ssr",
    "targets": {
      "typecheck": {
        "parallelism": false
      },
      "test": {
        "executor": "@nx/vitest:test",
        "outputs": [
          "{options.reportsDirectory}"
        ],
        "options": {
          "reportsDirectory": "coverage/packages/nest/angular-ssr"
        }
      },
      "test-consumer-lifecycle": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node --test tools/fixtures/nest-angular-ssr-consumer-attempt.test.mjs"
        },
        "inputs": [
          "default",
          "{workspaceRoot}/tools/fixtures/*nest-angular-ssr*",
          "{workspaceRoot}/apps/fixtures/nest-cjs-consumer/**/*",
          "{workspaceRoot}/apps/fixtures/nest-esm-consumer/**/*",
          "{workspaceRoot}/apps/fixtures/nest-angular-split/**/*"
        ]
      },
      "validate-consumers": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "test-consumer-lifecycle"
        ],
        "options": {
          "command": "node tools/fixtures/validate-nest-angular-ssr-consumers.mjs all"
        },
        "cache": false,
        "inputs": [
          "default",
          "{workspaceRoot}/tools/fixtures/*nest-angular-ssr*",
          "{workspaceRoot}/apps/fixtures/nest-cjs-consumer/**/*",
          "{workspaceRoot}/apps/fixtures/nest-esm-consumer/**/*",
          "{workspaceRoot}/apps/fixtures/nest-angular-split/**/*"
        ]
      },
      "validate-matrix": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node tools/fixtures/validate-nest-angular-ssr-matrix.mjs {args.cell}"
        },
        "cache": false,
        "inputs": [
          "default",
          "{workspaceRoot}/tools/fixtures/*nest-angular-ssr*",
          "{workspaceRoot}/apps/fixtures/nest-cjs-consumer/**/*",
          "{workspaceRoot}/apps/fixtures/nest-esm-consumer/**/*",
          "{workspaceRoot}/apps/fixtures/nest-angular-split/**/*"
        ]
      },
      "validate-split": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node tools/fixtures/validate-nest-angular-ssr-split.mjs"
        },
        "cache": false,
        "inputs": [
          "default",
          "{workspaceRoot}/tools/fixtures/*nest-angular-ssr*",
          "{workspaceRoot}/apps/fixtures/nest-cjs-consumer/**/*",
          "{workspaceRoot}/apps/fixtures/nest-esm-consumer/**/*",
          "{workspaceRoot}/apps/fixtures/nest-angular-split/**/*"
        ]
      }
    }
  },
  "dependencies": {
    "@fastify/static": "^10.1.7"
  }
}
